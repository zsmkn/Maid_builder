@@ -0,0 +1,90 @@
+package com.maidbuilder.client.ui;
+
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.gui.Font;
+import net.minecraft.client.gui.GuiGraphics;
+import net.minecraft.client.gui.components.Button;
+import net.minecraft.network.chat.Component;
+
+/** A button in the mod's flat look. Still a {@link Button}, so everything that works with one does. */
+public class FlatButton extends Button {
+    public enum Style {
+        /** The one main action of a screen. */
+        PRIMARY,
+        SECONDARY,
+        /** Something waiting for the player. */
+        ATTENTION,
+        /** A destructive action: red label. */
+        DANGER,
+        /** A tab or category: no frame until hovered or selected. */
+        TAB
+    }
+
+    private final Style style;
+    /** A tab that is the current one, or a toggle that is on. */
+    private boolean selected;
+    private boolean alignLeft;
+
+    public FlatButton(int x, int y, int width, int height, Component message, Style style, OnPress onPress) {
+        super(x, y, width, height, message, onPress, DEFAULT_NARRATION);
+        this.style = style;
+    }
+
+    public static FlatButton of(Component message, Style style, int width, int height, Runnable action) {
+        return new FlatButton(0, 0, width, height, message, style, b -> action.run());
+    }
+
+    public FlatButton selected(boolean value) {
+        this.selected = value;
+        return this;
+    }
+
+    public FlatButton alignLeft() {
+        this.alignLeft = true;
+        return this;
+    }
+
+    public boolean isSelected() {
+        return selected;
+    }
+
+    @Override
+    protected void renderWidget(GuiGraphics g, int mouseX, int mouseY, float partialTick) {
+        boolean hot = active && isHoveredOrFocused();
+        int fill, border, color;
+        switch (style) {
+            case PRIMARY -> {
+                fill = active ? (hot ? Ui.AMBER_LIGHT : Ui.AMBER) : Ui.BUTTON;
+                border = active ? Ui.AMBER_LIGHT : Ui.LINE;
+                color = active ? Ui.INK : Ui.DISABLED;
+            }
+            case ATTENTION -> {
+                fill = hot ? 0xFF54400F : Ui.AMBER_DARK;
+                border = Ui.AMBER;
+                color = Ui.AMBER;
+            }
+            case TAB -> {
+                fill = selected ? Ui.SELECT : hot ? Ui.BUTTON : 0;
+                border = selected ? Ui.FRAME : hot ? Ui.LINE_MID : 0;
+                color = selected || hot ? Ui.TEXT : Ui.MUTED;
+            }
+            default -> {
+                fill = selected ? Ui.SELECT : hot ? Ui.SELECT : Ui.BUTTON;
+                border = !active ? Ui.LINE : selected ? Ui.FRAME : hot ? Ui.TEXT : Ui.LINE_MID;
+                color = !active ? Ui.DISABLED : style == Style.DANGER ? Ui.RED : Ui.TEXT;
+            }
+        }
+        if (border != 0) Ui.box(g, getX(), getY(), width, height, fill, border);
+        Font font = Minecraft.getInstance().font;
+        Component message = getMessage();
+        int textWidth = font.width(message);
+        int ty = getY() + (height - 8) / 2;
+        if (alignLeft) {
+            Ui.textClipped(g, font, message, getX() + 5, ty, width - 8, color);
+        } else if (textWidth <= width - 4) {
+            g.drawString(font, message, getX() + (width - textWidth) / 2, ty, color, false);
+        } else {
+            Ui.textClipped(g, font, message, getX() + 3, ty, width - 6, color);
+        }
+    }
+}
diff --git a/forge/src/main/java/com/maidbuilder/client/ui/HudCard.java b/forge/src/main/java/com/maidbuilder/client/ui/HudCard.java
new file mode 100644
index 0000000..e315894
--- /dev/null
+++ b/forge/src/main/java/com/maidbuilder/client/ui/HudCard.java
@@ -0,0 +1,222 @@
+package com.maidbuilder.client.ui;
+
+import net.minecraft.client.gui.Font;
+import net.minecraft.client.gui.GuiGraphics;
+import net.minecraft.network.chat.Component;
+import net.minecraft.util.FormattedCharSequence;
+import net.minecraft.world.item.Item;
+import net.minecraft.world.item.ItemStack;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * An in-world overlay card: rows are added top to bottom, then it sizes itself to the widest one
+ * and draws at the given spot.
+ */
+public final class HudCard {
+    private static final int PAD = 5, LINE = 11, MIN_WIDTH = 150, WRAP = 230;
+
+    private interface Row {
+        int width(Font font);
+
+        int height();
+
+        void draw(GuiGraphics g, Font font, int x, int y, int width);
+    }
+
+    /** A key (or two that belong together) and what it does. */
+    public record Key(List<Component> caps, Component label) {
+        public Key(Component cap, Component label) {
+            this(List.of(cap), label);
+        }
+    }
+
+    /** An item and how many of it. */
+    public record Count(Item item, int count) {
+    }
+
+    private final Font font;
+    private final List<Row> rows = new ArrayList<>();
+
+    public HudCard(Font font) {
+        this.font = font;
+    }
+
+    public HudCard text(Component text, int color) {
+        rows.add(new Row() {
+            @Override
+            public int width(Font font) {
+                return font.width(text);
+            }
+
+            @Override
+            public int height() {
+                return LINE;
+            }
+
+            @Override
+            public void draw(GuiGraphics g, Font font, int x, int y, int width) {
+                g.drawString(font, text, x, y + 1, color, false);
+            }
+        });
+        return this;
+    }
+
+    /** Longer text, wrapped instead of making the card very wide. */
+    public HudCard wrapped(Component text, int color) {
+        for (FormattedCharSequence line : font.split(text, WRAP)) {
+            rows.add(new Row() {
+                @Override
+                public int width(Font font) {
+                    return font.width(line);
+                }
+
+                @Override
+                public int height() {
+                    return LINE - 1;
+                }
+
+                @Override
+                public void draw(GuiGraphics g, Font font, int x, int y, int width) {
+                    g.drawString(font, line, x, y + 1, color, false);
+                }
+            });
+        }
+        return this;
+    }
+
+    /** A progress bar with its figures to the right. */
+    public HudCard bar(double fraction, String label, int color) {
+        rows.add(new Row() {
+            @Override
+            public int width(Font font) {
+                return 60 + 6 + font.width(label);
+            }
+
+            @Override
+            public int height() {
+                return LINE;
+            }
+
+            @Override
+            public void draw(GuiGraphics g, Font font, int x, int y, int width) {
+                int labelWidth = font.width(label);
+                Ui.bar(g, x, y + 2, width - labelWidth - 6, fraction, color);
+                g.drawString(font, label, x + width - labelWidth, y + 1, Ui.TEXT, false);
+            }
+        });
+        return this;
+    }
+
+    public HudCard rule() {
+        rows.add(new Row() {
+            @Override
+            public int width(Font font) {
+                return 0;
+            }
+
+            @Override
+            public int height() {
+                return 5;
+            }
+
+            @Override
+            public void draw(GuiGraphics g, Font font, int x, int y, int width) {
+                g.fill(x, y + 2, x + width, y + 3, Ui.LINE_SOFT);
+            }
+        });
+        return this;
+    }
+
+    /** A label followed by item icons with their counts, a few per line. */
+    public HudCard items(Component label, int labelColor, List<Count> counts) {
+        int perLine = 4;
+        for (int start = 0; start < counts.size(); start += perLine) {
+            List<Count> part = counts.subList(start, Math.min(counts.size(), start + perLine));
+            boolean first = start == 0;
+            int labelWidth = font.width(label) + 6;
+            rows.add(new Row() {
+                @Override
+                public int width(Font font) {
+                    int w = labelWidth;
+                    for (Count c : part) w += 17 + font.width(String.valueOf(c.count())) + 5;
+                    return w;
+                }
+
+                @Override
+                public int height() {
+                    return 17;
+                }
+
+                @Override
+                public void draw(GuiGraphics g, Font font, int x, int y, int width) {
+                    if (first) g.drawString(font, label, x, y + 5, labelColor, false);
+                    int at = x + labelWidth;
+                    for (Count c : part) {
+                        g.renderItem(new ItemStack(c.item()), at, y);
+                        String n = String.valueOf(c.count());
+                        g.drawString(font, n, at + 17, y + 5, Ui.TEXT, false);
+                        at += 17 + font.width(n) + 5;
+                    }
+                }
+            });
+        }
+        return this;
+    }
+
+    /** Key caps with what each does, on one line. */
+    public HudCard keys(List<Key> keys) {
+        rows.add(new Row() {
+            @Override
+            public int width(Font font) {
+                int w = 0;
+                for (Key key : keys) {
+                    for (Component cap : key.caps()) w += Ui.keycapWidth(font, cap) + 2;
+                    w += 1 + font.width(key.label()) + 7;
+                }
+                return w - 7;
+            }
+
+            @Override
+            public int height() {
+                return 13;
+            }
+
+            @Override
+            public void draw(GuiGraphics g, Font font, int x, int y, int width) {
+                int at = x;
+                for (Key key : keys) {
+                    for (Component cap : key.caps()) at += Ui.keycap(g, font, cap, at, y + 1) + 2;
+                    g.drawString(font, key.label(), at + 1, y + 3, Ui.MUTED, false);
+                    at += 1 + font.width(key.label()) + 7;
+                }
+            }
+        });
+        return this;
+    }
+
+    public int width() {
+        int w = MIN_WIDTH;
+        for (Row row : rows) w = Math.max(w, row.width(font));
+        return w + 2 * PAD;
+    }
+
+    public int height() {
+        int h = 2 * PAD - 1;
+        for (Row row : rows) h += row.height();
+        return h;
+    }
+
+    /** Draws the card with its top-left corner at {@code x}/{@code y}. */
+    public void render(GuiGraphics g, int x, int y, int border) {
+        int w = width(), h = height();
+        g.fill(x, y, x + w, y + h, Ui.HUD);
+        Ui.outline(g, x, y, w, h, border);
+        int at = y + PAD - 1;
+        for (Row row : rows) {
+            row.draw(g, font, x + PAD, at, w - 2 * PAD);
+            at += row.height();
+        }
+    }
+}
