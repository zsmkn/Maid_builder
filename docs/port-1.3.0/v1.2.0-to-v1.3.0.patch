+    /** A key cap with the key's name; returns its width. */
+    public static int keycap(GuiGraphics g, Font font, Component key, int x, int y) {
+        int w = Math.max(11, font.width(key) + 6);
+        box(g, x, y, w, 11, SELECT, LINE_MID);
