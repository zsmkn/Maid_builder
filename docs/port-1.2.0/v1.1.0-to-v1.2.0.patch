+            for (int z = 0; z < s; z++) {
+                boolean edge = x == 0 || z == 0 || x == s - 1 || z == s - 1;
+                g.set(x, 0, z, edge ? "cobblestone" : "dirt");
+            }
+        }
+        for (int z = 1; z <= 7; z++) g.set(5, 0, z, "cobblestone");
